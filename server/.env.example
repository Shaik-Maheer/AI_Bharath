PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/adhikarloop
JWT_SECRET=replace-with-a-strong-local-secret
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
MONGO_FALLBACK_TO_MEMORY=false

# Atlas example:
# MONGO_URI=mongodb+srv://username:<db_password>@cluster.mongodb.net/adhikarloop?retryWrites=true&w=majority&appName=YourApp

# Demo-only mode when MongoDB is not installed:
# MONGO_URI=memory
# AUTO_SEED=true
