NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.230fpdv.mongodb.net/aibharath?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=replace-with-a-strong-secret-min-16-chars
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
MONGO_FALLBACK_TO_MEMORY=false
AUTO_SEED=false

# Retry/connection tuning
DB_MAX_RETRIES=5
DB_RETRY_DELAY_MS=2000
DB_SERVER_SELECTION_TIMEOUT_MS=10000
DB_SOCKET_TIMEOUT_MS=45000
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=2

# Render deployment notes:
# NODE_ENV=production
# PORT=10000
# CLIENT_ORIGIN=https://<your-frontend-domain>
# RENDER_EXTERNAL_URL=https://<your-render-service>.onrender.com

# Demo-only mode when MongoDB is not installed:
# MONGODB_URI=memory
# AUTO_SEED=true
