{
  "name": "adhikarloop-server",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/free-port.ps1 && nodemon server.js",
    "dev:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/free-port.ps1 && nodemon server.js",
    "dev:demo": "cross-env MONGODB_URI=memory AUTO_SEED=true nodemon server.js",
    "start": "node server.js",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.3.0",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
